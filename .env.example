# Reference configuration. Never commit filled-in copies or put backend secrets in the APK.
# Convex CLI maintains backend/.env.local automatically; this file is documentation,
# not a file read automatically by Gradle or uploaded automatically to Convex.
# Set backend secrets with `cd backend && npx convex env set NAME` (add --prod for production).

# Hosted identifiers. HTTP actions use .convex.site; the Convex client uses .convex.cloud.
CONVEX_DEPLOYMENT=dev:your-development-deployment
CONVEX_URL=https://your-development-deployment.eu-west-1.convex.cloud
CONVEX_SITE_URL=https://your-development-deployment.eu-west-1.convex.site
# CI only: create a narrowly scoped deploy key from the Convex dashboard.
# Do not copy the locally authenticated CLI's access token here.
CONVEX_DEPLOY_KEY=

# Resend: verify a domain you own, then create a sending API key.
# This is a server-only secret. The default test mode permits Resend test inboxes only.
RESEND_API_KEY=re_replace_with_sending_key
EMAIL_FROM=Curated Phone <approvals@approvals.your-domain.be>
RESEND_TEST_MODE=true
# Set false deliberately after domain verification and guardian test delivery.
# Configure all email.* events at POST /resend-webhook in the matching deployment.
RESEND_WEBHOOK_SECRET=whsec_replace_with_webhook_signing_secret

# Generate independent development/production values with backend/scripts/generate-secrets.mjs.
# These are configured automatically for this machine's created Convex deployments.
# Recovery copies live in private .secrets directories, excluded from Git.
OTP_HMAC_SECRET=replace_with_32_random_bytes_base64
DEVICE_TOKEN_HMAC_SECRET=replace_with_different_32_random_bytes_base64
# PKCS8 PEM P-256 private key, actual newlines. Never place in Android configuration.
APPROVAL_SIGNING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_pkcs8_pem\n-----END PRIVATE KEY-----"
APPROVAL_SIGNING_KEY_ID=production-p256-1

# Public Android build values. Export in the shell or pass with -PNAME=value.
# A public SPKI PEM is safe to include in the APK. The key ID must match the backend.
CURATED_BACKEND_URL=https://your-production-deployment.eu-west-1.convex.site
CURATED_APPROVAL_KEY_ID=production-p256-1
# Prefer this file option to multiline environment values.
CURATED_APPROVAL_PUBLIC_KEY_FILE=/absolute/private-backup/approval-public-key.pem
# Alternative to the file option (leave empty when using the file):
CURATED_APPROVAL_PUBLIC_KEY=

# Must stay false until exact Samsung release APK tests pass and evidence is recorded.
# Removal currently evaluates clearDeviceOwnerApp; Android deprecates it for production.
# If that route fails, implement and validate a supported route before changing the flag.
CURATED_REMOVAL_VALIDATED=false
# This gates final debugging/safe-boot/user restrictions. Never enable during ADB development.
CURATED_BYPASS_PROTECTION_VALIDATED=false

# Release signing: stable keystore outside the repository. Never use debug signing for daily enrolment.
# scripts/build-release.mjs reads a protected local signing-config.json created by scripts/create-signing-key.mjs.
CURATED_KEYSTORE_FILE=/absolute/private-signing/curated-phone.jks
CURATED_KEYSTORE_PASSWORD=replace_with_private_password
CURATED_KEY_ALIAS=curated-phone
CURATED_KEY_PASSWORD=replace_with_private_password

# SDK/JDK are local tools, not application secrets. Install with scripts/setup-linux.sh.
ANDROID_HOME=/home/your-user/Android/sdk
JAVA_HOME=/absolute/path/to/jdk-21
# Emulator manager and emulator must use the same AVD directory on XDG Linux desktops.
ANDROID_AVD_HOME=/home/your-user/.config/.android/avd

# Guardian addresses are supplied to the internal pairing command, not embedded in builds.
# Neither real inbox is accessible to the phone user. Use separate test inboxes in development.
PRIMARY_GUARDIAN_EMAIL=primary-guardian@example.org
BACKUP_GUARDIAN_EMAIL=recovery-guardian@example.org
# Knox SDK is downloaded from Samsung and placed at android/app/libs/knoxsdk.jar (ignored).
# Activate the suitable licence on-device using Status > Knox licence. Never embed it in the APK.
# Category feed URLs/licences are part of the guardian-approved snapshot, not secret environment values.
